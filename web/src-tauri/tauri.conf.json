{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeaceParrot",
  "version": "1.0.1",
  "identifier": "com.peaceparrot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PeaceParrot",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFNDI4NDQ4N0E3M0U2NUYKUldSZjVuTjZTSVJDL25WSTJmamRmZTEwVHh5TzZJUXF6N1ZvU2VjQUFidVJudnd1blMvQmc1dG8K",
      "endpoints": [
        "https://github.com/abdafwann/peace-parrot/releases/latest/download/latest.json"
      ]
    }
  }
}
